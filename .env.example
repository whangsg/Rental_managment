# Flask 세션 서명 키 (운영에서는 긴 랜덤 문자열로)
SECRET_KEY=change-me

# DB (생략하면 backend/rental.db SQLite 사용)
# DATABASE_URL=sqlite:///rental.db

# ESP32가 X-Device-Key 헤더로 보내는 키
DEVICE_API_KEY=change-me-device-key

# 태깅 후 본인 확인 제한시간(초), 예약 픽업 기한(시간)
CONFIRMATION_TIMEOUT_SECONDS=60
PICKUP_DEADLINE_HOURS=24

# 프론트엔드 주소 (여러 개면 쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 세션 쿠키 설정 (HTTPS 배포 시 SESSION_COOKIE_SECURE=true 권장)
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
